{
  "manifest_version": 3,
  "name": "BootyBoots Terapeak Helper",
  "version": "1.0.0",
  "description": "Price checks on eBay Terapeak for BootyBoots: Kim's own look-ups plus Christina's list. Uses no AI. Read-only on eBay.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.ebay.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BootyBoots Terapeak Helper",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.com/sh/research*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}