{
  "manifest_version": 3,
  "name": "QEM Terapeak Helper (Christina)",
  "version": "0.1.0",
  "description": "Looks up eBay Terapeak sold and active numbers for Christina's price checks, in place of Chrome Claude. Read-only.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "clipboardWrite"],
  "host_permissions": [
    "https://www.ebay.com/*",
    "https://raw.githubusercontent.com/*",
    "https://docs.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "QEM Terapeak Helper" },
  "content_scripts": [{
    "matches": ["https://www.ebay.com/sh/research*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
